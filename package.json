{
  "name": "industrial-crm",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "setup": "npm install && npm run db:setup",
    "db:setup": "npm run db:generate --workspace=backend && npm run db:push --workspace=backend && npm run db:seed --workspace=backend"
  },
  "dependencies": {
    "multer": "^2.2.0",
    "node-cron": "^4.5.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "sql.js": "^1.14.1",
    "xlsx": "^0.18.5"
  }
}
